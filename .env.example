# Copy to .env and fill in. Everything is optional: without credentials the
# dashboard still works by uploading CSV exports.

PORT=3000
# Protects the dashboard with a browser login prompt (any username).
DASHBOARD_PASSWORD=

# WhatConverts: Integrations > API Keys (profile key or master account key)
WHATCONVERTS_API_TOKEN=
WHATCONVERTS_API_SECRET=
# Only needed with a master account key, to pick one profile
WHATCONVERTS_PROFILE_ID=

# Google (Ads, Analytics 4, Search Console): one OAuth client of type
# "Web application" with this authorized redirect URI:
#   http://localhost:3000/auth/google/callback   (or your PUBLIC_URL + /auth/google/callback)
# Then open the dashboard and click Connections > Connect Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed if the dashboard runs behind a proxy or on a custom domain,
# e.g. https://leads.example.com
PUBLIC_URL=

# Optional: skip the picker in the Connections panel
GA4_PROPERTY_ID=
SEARCH_CONSOLE_SITE_URL=

# Google Ads also needs a developer token and the account to report on
GOOGLE_ADS_DEVELOPER_TOKEN=
# The ad account to report on, e.g. 123-456-7890
GOOGLE_ADS_CUSTOMER_ID=
# Your MCC (manager) account ID, if access is through a manager account
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25
